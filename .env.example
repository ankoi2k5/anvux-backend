# Sao chép thành .env nếu muốn đổi cấu hình (không commit file .env)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=anvux
DB_USER=anvux
DB_PASSWORD=anvux_dev_password

# ---- AI ----
# fake      : kế hoạch mẫu, không cần khóa (mặc định, dùng cho test)
# openai    : dịch vụ theo chuẩn OpenAI chat/completions (có gói miễn phí) - xem 3 mẫu bên dưới
# anthropic : Claude (trả phí)
AI_PROVIDER=fake
AI_API_KEY=

# Mẫu 1 - Google Gemini (AI Studio, gói miễn phí, không cần thẻ). Lấy khóa: https://aistudio.google.com/apikey
# AI_PROVIDER=openai
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-latest

# Mẫu 2 - Groq (gói miễn phí, rất nhanh). Lấy khóa: https://console.groq.com/keys
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Mẫu 3 - OpenRouter (mô hình có hậu tố :free). Lấy khóa: https://openrouter.ai/keys
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<chọn một mô hình có hậu tố :free trên openrouter.ai/models>

# Claude (trả phí): AI_PROVIDER=anthropic, AI_BASE_URL=https://api.anthropic.com, AI_MODEL=<mô hình Claude>

# Giới hạn số kế hoạch AI mỗi người dùng (nên thấp hơn hạn mức miễn phí của nhà cung cấp)
AI_MAX_PLANS_PER_HOUR=10
AI_MAX_PLANS_PER_DAY=30
